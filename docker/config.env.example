# Required: at least one API key
OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-...
# LITELLM_API_KEY=sk-...
# LITELLM_BASE_URL=http://localhost:4000

# Model to evaluate (default: gpt-4o-mini-2024-07-18)
AMBENCH_MODEL=gpt-4o-mini-2024-07-18

# Scoring strategy (default: auto)
AMBENCH_SCORING=auto
